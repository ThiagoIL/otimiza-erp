# ---------- Obrigatórias ----------
# Banco PostgreSQL (no Easypanel, copie a "Internal Connection URL" do serviço Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/otimiza_erp"
# Domínio principal, sem https e sem barra. Em desenvolvimento use localhost:3000
ROOT_DOMAIN="localhost:3000"

# ---------- Conta master (usadas só na primeira subida) ----------
# Criam o administrador master do sistema se ele ainda não existir. Depois de criado,
# apague INITIAL_ADMIN_PASSWORD das variáveis de ambiente.
INITIAL_ADMIN_NAME="Seu Nome"
INITIAL_ADMIN_EMAIL="voce@seudominio.com.br"
INITIAL_ADMIN_PASSWORD=""

# ---------- Opcionais ----------
# Subdomínio do painel do administrador do sistema (padrão: admin)
ADMIN_SUBDOMAIN="admin"
# Cookies só por HTTPS. Padrão: true em produção. Use false apenas em desenvolvimento local.
COOKIE_SECURE="false"
# Duração máxima da sessão (horas) e tempo sem uso até sair (minutos)
SESSION_HOURS="12"
SESSION_IDLE_MINUTES="120"
# Confiar no IP informado pelo proxy (Traefik do Easypanel). Mantenha true atrás do Easypanel.
TRUST_PROXY="true"
# Fuso para exibir datas
APP_TIMEZONE="America/Sao_Paulo"
# Conexões simultâneas com o banco por instância
DATABASE_POOL_MAX="10"
